{
  "name": "embedded-story-map",
  "version": "0.3.0",
  "description": "Git-backed user story maps embedded in product applications",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duncan-m/embedable-story-map.git"
  },
  "type": "module",
  "engines": { "node": ">=20" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./styles.css": "./styles.css"
  },
  "bin": { "story-map": "./dist/cli.js" },
  "files": ["dist", "styles.css", "docs/story-map.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "validate": "node dist/cli.js validate product/story-map.yaml",
    "test": "npm run build && node --test",
    "demo": "npm run build && node example/demo.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.0"
  }
}
