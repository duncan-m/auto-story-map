{
  "name": "auto-story-map",
  "version": "0.7.6",
  "description": "Git-backed user story maps embedded in product applications",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Duncan Malcolm",
    "url": "https://github.com/duncan-m"
  },
  "keywords": [
    "story-map",
    "user-story-mapping",
    "roadmap",
    "product-management",
    "react",
    "yaml"
  ],
  "homepage": "https://github.com/duncan-m/auto-story-map#readme",
  "bugs": "https://github.com/duncan-m/auto-story-map/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duncan-m/auto-story-map.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./board.js": {
      "types": "./dist/board.d.ts",
      "default": "./dist/board.js"
    },
    "./styles.css": "./styles.css",
    "./schema.json": "./story-map.schema.json"
  },
  "bin": {
    "story-map": "./dist/cli.js"
  },
  "files": [
    "dist",
    "styles.css",
    "story-map.schema.json",
    "templates",
    "docs/story-map.md",
    "docs/example-builder-estimate-plan.md",
    "docs/example-builder-estimate-mockup.html",
    "docs/example-builder-estimate-mockup.png",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/write-version.mjs && tsc -p tsconfig.json && node scripts/build-schema.mjs",
    "prepare": "npm run build",
    "validate": "node dist/cli.js validate --check-sources --plans docs --tests test product/story-map.yaml",
    "test": "npm run build && node --test",
    "lint": "biome ci",
    "demo": "npm run build && node example/demo.mjs",
    "known-versions": "npm run build && node scripts/known-versions.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~7.0.2"
  }
}
