{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "Story map format version."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "description": "Product-specific map ID."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Internal map title."
    },
    "summary": {
      "description": "Optional internal map summary.",
      "type": "string",
      "maxLength": 500
    },
    "visibility": {
      "default": "internal",
      "description": "internal: only internal viewers can see the map. all-users: signed-in users see the customer-facing view.",
      "type": "string",
      "enum": [
        "internal",
        "all-users"
      ]
    },
    "customer": {
      "description": "Customer-facing map title and summary. Required when visibility is all-users.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Customer-facing title. Add only after the wording is approved."
        },
        "summary": {
          "description": "Optional customer-facing summary.",
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "stalledAfterWeeks": {
          "description": "Flag a story as stalled when it has been in progress for longer than this many weeks. Defaults to 4. 0 turns the flag off. Needs the history file from `story-map history`.",
          "type": "integer",
          "minimum": 0,
          "maximum": 104
        }
      },
      "additionalProperties": false,
      "description": "Optional settings for everyone who views the map. Hosts can override them."
    },
    "activities": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "description": "Stable activity ID that stories reference. Keep it when renaming."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Internal activity title."
          },
          "summary": {
            "description": "Optional internal activity summary.",
            "type": "string",
            "maxLength": 500
          },
          "customer": {
            "description": "Customer-facing activity label. Required before a customer-facing story can use this activity.",
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Customer-facing title. Add only after the wording is approved."
              },
              "summary": {
                "description": "Optional customer-facing summary.",
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "description": "Activities run left to right in the order of the user journey."
      }
    },
    "releases": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "description": "Stable release ID that stories reference. Keep it when renaming."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Internal release title."
          },
          "summary": {
            "description": "Optional internal release summary.",
            "type": "string",
            "maxLength": 500
          },
          "customer": {
            "description": "Customer-facing release label. Required before a customer-facing story can use this release.",
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Customer-facing title. Add only after the wording is approved."
              },
              "summary": {
                "description": "Optional customer-facing summary.",
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "notes": {
            "description": "Optional internal release notes: plain text up to 800 characters. Blank lines separate paragraphs. No Markdown.",
            "type": "string",
            "maxLength": 800
          },
          "impact": {
            "description": "Optional, recommended. Up to 10 expected outcomes of the release. Internal only.",
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "What is measured, such as “Estimate turnaround time”."
                },
                "expected": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "The expected change, written for people, such as “Decrease from 3 days to 1 day”. Not parsed."
                },
                "solves": {
                  "description": "Optional. The problem this addresses.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "actual": {
                  "description": "Optional. The measured result, added after shipping.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "draft": {
                  "description": "true when an agent drafted this item and nobody has confirmed it yet. Only a person removes it.",
                  "type": "boolean"
                }
              },
              "required": [
                "metric",
                "expected"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "description": "Releases run top to bottom in delivery order."
      }
    },
    "stories": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "description": "Stable story ID, such as BUILDER-102. Keep it when renaming or moving the story."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Outcome-focused internal title."
          },
          "activity": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "description": "ID of the activity column this story sits under."
          },
          "release": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "description": "ID of the release lane this story belongs to."
          },
          "summary": {
            "description": "Optional internal summary, shown when the card is opened.",
            "type": "string",
            "maxLength": 500
          },
          "status": {
            "default": "planned",
            "description": "planned: agreed work awaiting implementation. in-progress: work has started. merged: the work is merged to the default branch but not yet available to its intended users; customers see it as in progress. shipped: available to its intended users. blocked: started or agreed, but cannot continue. cut: deliberately dropped from its release. Blocked and cut stories are hidden by default and never shown to customers.",
            "type": "string",
            "enum": [
              "planned",
              "in-progress",
              "merged",
              "shipped",
              "blocked",
              "cut"
            ]
          },
          "statusReason": {
            "description": "Why the story is blocked or cut. Internal only.",
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "updatedBy": {
            "description": "Optional. Display name of the person to credit for this edit, when it is not the commit author. The status history credits Git otherwise.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notes": {
            "description": "Internal engineering notes.",
            "type": "string",
            "maxLength": 4000
          },
          "sources": {
            "description": "Supporting docs, tests or links. The first Markdown link with a #heading becomes the Engineering overview link.",
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            }
          },
          "customer": {
            "description": "Customer-facing copy. Add only when the story is approved for all users.",
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Customer-facing title. Add only after the wording is approved."
              },
              "summary": {
                "description": "Optional customer-facing summary.",
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "activity",
          "release"
        ],
        "additionalProperties": false,
        "description": "Stories appear in this order within each cell."
      }
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "activities",
    "releases",
    "stories"
  ],
  "additionalProperties": false,
  "title": "Auto Story Map",
  "description": "A Git-backed user story map. Validate cross-references with `story-map validate`.",
  "$id": "https://raw.githubusercontent.com/duncan-m/auto-story-map/main/story-map.schema.json"
}
